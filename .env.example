# Authorized Telegram reader (required only for `python -m telegram.reader`).
# Obtain the API ID and hash at https://my.telegram.org. Never commit real values.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# A username such as my_channel, or numeric channel ID such as -1001234567890.
TELEGRAM_CHANNEL=
TELEGRAM_SESSION_PATH=data/telegram_reader

# Reserved for future local MT5 DEMO configuration.
MT5_DEMO_LOGIN=
MT5_DEMO_PASSWORD=
MT5_DEMO_SERVER=
